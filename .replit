run = "cd frontend && npm install && VITE_USE_MOCKS=false npm run build && cd ../backend && npm install && PORT=5173 node src/server.js"
modules = ["nodejs-20"]

[[ports]]
localPort = 5173
externalPort = 80

[deployment]
build = ["sh", "-c", "cd frontend && npm install && npm run build"]
run = ["sh", "-c", "cd frontend && VITE_USE_MOCKS=false npm run build && cd ../backend && npm install && PORT=5173 node src/server.js"]
deploymentTarget = "cloudrun"
